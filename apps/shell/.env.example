# Backend API origin; the browser calls it directly (e.g. ${NEXT_PUBLIC_API_URL}/auth/login).
# Copy this file to .env.local and set it. The backend must allow CORS from this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:9090

# Production only: where the shell proxies /projects and /billing (Multi-Zones).
# Unset in dev, where they default to http://localhost:3001 and :3002.
# PROJECTS_ZONE_URL=https://ptp-projects.vercel.app
# BILLING_ZONE_URL=https://ptp-billing.vercel.app

# DEMO ONLY: skip the emailed 6-digit code after login (default: true). Set to false to require it.
# NEXT_PUBLIC_SKIP_OTP=false
